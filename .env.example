# Copy to .env or export in your shell. All keys are optional; see docs/data-sources.md.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
ANTHROPIC_API_KEY=
# Identify yourself to SEC EDGAR (required by their fair-access policy)
FREEDOM_SEC_USER_AGENT="freedom-harness your-email@example.com"
# Walk-forward folds need this many trainable events before a season; lower it (e.g. 12) for
# small datasets such as the README example, else `freedom evaluate` / `optimize` exit 2.
# FREEDOM_MIN_TRAIN_EVENTS=120
